# Your edge proxy — owns 80/443, automatic HTTPS (Let's Encrypt). {$DOMAIN} is injected from the
# Compose environment.
#
# Routes:
#   api.{$DOMAIN}    → backend:8080
#   files.{$DOMAIN}  → minio:9000     (presigned image URLs)
#   admin.{$DOMAIN}  → admin:3000     (admin Next app)
#   store.{$DOMAIN}  → storefront:3000 (storefront Next app; path-based multi-tenant /{orgSlug})
#
# Every host's A record must resolve to this server before first boot (Caddy fetches certs on start).

{
	# Contact address for Let's Encrypt expiry notices.
	email admin@{$DOMAIN}
}

api.{$DOMAIN} {
	reverse_proxy backend:8080
	encode gzip
}

files.{$DOMAIN} {
	# Caddy preserves the Host header by default — MinIO SigV4 presigned URLs need that.
	reverse_proxy minio:9000
}

admin.{$DOMAIN} {
	reverse_proxy admin:3000
	encode gzip
}

store.{$DOMAIN} {
	reverse_proxy storefront:3000
	encode gzip
}

# Server-local site blocks, kept OUTSIDE this repo so re-copying it never clobbers them. Drop
# extra `*.caddy` files in /opt/ststore/caddy.d/ on the VPS (mounted read-only into the container).
import /etc/caddy/conf.d/*.caddy
