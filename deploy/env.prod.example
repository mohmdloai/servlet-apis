# ─────────────────────────────────────────────────────────────────────────────
# Production runtime config for the VPS. Copy to `.env` next to docker-compose.prod.yml:
#     cp env.prod.example .env    # then fill in the secrets
# NEVER commit the real .env (it is gitignored). Compose reads it via --env-file .env.
# ─────────────────────────────────────────────────────────────────────────────

# Your registrable domain (no scheme). The apex is the marketing site; api./files./admin./store.
# subdomains hang off it. Caddy routes <domain> → marketing, api.<domain> → backend,
# files.<domain> → minio, admin./store.<domain> → the Next apps (see the Caddyfile).
DOMAIN=yabta3.com

# Lets bare `docker compose ...` find this stack's file (Compose auto-loads .env from the cwd),
# so the CI deploy and manual commands don't need an explicit -f.
COMPOSE_FILE=docker-compose.prod.yml

# Which backend image to run. CI publishes :latest and :<sha> to GHCR on every push to master.
# Pin to a :<sha> to roll back to a known-good build.
BACKEND_IMAGE=ghcr.io/mohmdloai/inventory-api:latest

# Frontend images (built + published by the frontst repo's CI). Same roll-back knob: pin a :<sha>.
# admin/storefront default inline in the compose file; the marketing apex is set here for symmetry.
# MARKETING_IMAGE=ghcr.io/mohmdloai/marketing:latest

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=inventorydb
POSTGRES_USER=postgres
# Strong password — used by both the db container and the backend. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ── Object storage (MinIO / S3) ─────────────────────────────────────────────
# These become the MinIO root credentials AND the backend's S3 signing keys. Generate each:
#   openssl rand -hex 20
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ── Auth secrets (REQUIRED — server refuses to start without these) ──────────
# Base64, ≥32 bytes after decode. Generate each independently: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
CUSTOMER_JWT_SECRET=CHANGE_ME

# ── Transactional email (optional) ──────────────────────────────────────────
# Gmail account + App Password (NOT the login password). Leave BOTH blank to disable real sends
# (the app logs emails instead). Non-secret SMTP host/port live in mail.properties.
SMTP_USERNAME=
SMTP_PASSWORD=

# Web Push (V96, stories/web_push_channel.md). The server's VAPID identity: ONE P-256 key pair,
# generated once and kept like JWT_SECRET. Generate with `npx web-push generate-vapid-keys` and
# paste the two base64url values verbatim (public = 65-byte uncompressed point, private = 32-byte
# scalar). Leave both empty to keep the channel off — the admin's push switch then honestly reads
# "unavailable". Setting only one, or a pair that does not belong together, refuses to start.
# Rotating the pair silently orphans every existing browser subscription (they were minted against
# the old public key and the push services will reject the new signature): if you must rotate,
# tell staff to flip the switch off and on again on each phone.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# RFC 8292 `sub`: where a push service can reach the operator. mailto: or https:.
WEB_PUSH_SUBJECT=mailto:ops@yabta3.com

# ─────────────────────────────────────────────────────────────────────────────
# The following are set for you in docker-compose.prod.yml (service-name wiring, COOKIE_SECURE,
# TRUST_PROXY, CORS_ALLOWED_ORIGINS, PUBLIC_BASE_URL, MINIO_PUBLIC_ENDPOINT) and normally need no
# override. See the backend `environment:` block if you want to change them.
# ─────────────────────────────────────────────────────────────────────────────
